rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Security Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity Validation Helper
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
             (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 256)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             data.createdAt is timestamp;
    }

    // 4. Users Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().createdAt == request.time;
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'email', 'createdAt']);
      allow delete: if false;
    }
  }
}
