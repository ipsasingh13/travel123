{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "description": "User display name",
          "maxLength": 256
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar photo URL",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user account profile was initialized"
        }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles keyed by their Firebase Auth UID"
    }
  }
}
